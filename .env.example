# Atelier — every environment variable this system reads.
#
# Validated at startup by packages/config (`loadEnv`). A missing or malformed
# value stops the process with exit code 78 (EX_CONFIG) and a list of every
# problem found, rather than failing later on the first request that needs it.
#
# This file is checked for COMPLETENESS by a test: a variable in the schema but
# not here fails the build, and so does a variable here that the schema does not
# know about. It cannot drift.
#
# Local use (Node 24 reads env files natively — no dotenv dependency):
#   cp .env.example .env
#   node --env-file=.env <entrypoint>

# ── Runtime ─────────────────────────────────────────────────────────────────
# development | test | production
NODE_ENV=development

# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Port the API listens on. Railway injects this in staging.
PORT=3001

# Git SHA of the running build. CI sets it; empty locally.
GIT_SHA=

# ── Data ────────────────────────────────────────────────────────────────────
# Must be a postgres:// or postgresql:// connection string.
# Treated as a secret: its value is never echoed in an error message, because
# the password is in it.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/atelier

# ── Observability ───────────────────────────────────────────────────────────
# OTLP collector endpoint. Leave unset to run without an exporter: spans are
# still created, just dropped. Telemetry must not make a collector a hard
# dependency of the process.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ── Model providers ─────────────────────────────────────────────────────────
# At least ONE of these is required when NODE_ENV=production; all are optional
# otherwise, so a clean checkout can run the tests and the dev server without a
# real key. Which provider the platform uses is still an open decision — see
# docs/decisions/DECISION-LOG.md.
#
# Never commit a real value. All three are secrets: never echoed in an error.

# Primary provider in the current plan. Real keys carry an "sk or" style prefix.
OPENROUTER_API_KEY=sk-or-EXAMPLE-not-a-real-key

# Failover, used when the primary is unavailable or rate-limited.
GROQ_API_KEY=gsk_EXAMPLEnotarealkey

# Required by ADR-002 (Managed Agents), which is still the architecture of
# record. Leave unset if you are not using it.
ANTHROPIC_API_KEY=sk-ant-EXAMPLE-not-a-real-key

# ── Authentication (M014) ───────────────────────────────────────────────────
# Identity runs as its OWN database role (ADR-010). Same database, different
# credentials: `atelier_auth` reads identity and cannot touch tenant data,
# `atelier_app` is the reverse and cannot read a password hash.
#
# Pointing both at the same credentials would collapse that boundary in
# silence — everything would still work, and the separation the isolation
# suite asserts would be fiction. Use two roles.
AUTH_DATABASE_URL=postgresql://atelier_auth_login:atelier_auth_password@localhost:5432/atelier

# Signs session cookies and tokens. At least 32 characters. Rotating it
# invalidates every session, which is the fastest way to log everyone out.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=EXAMPLE-change-me-at-least-32-characters-long

# Public origin the auth endpoints are reached on. Must match what the browser
# sees, or the cookie is set for the wrong host and sign-in silently fails.
AUTH_BASE_URL=http://localhost:3001

# ── Transactional email (ADR-011) ───────────────────────────────────────────
# Verification and password reset. Without a key the console adapter is used,
# which prints the link instead of sending it — the right default locally.
RESEND_API_KEY=re_EXAMPLEnotarealkey

# Must be on a domain verified with Resend, or every send fails.
EMAIL_FROM=Atelier <noreply@example.test>

# ── OAuth (FR-AUTH-2) ───────────────────────────────────────────────────────
# Both halves of a pair are required together — the schema refuses half a
# provider, because half a provider boots fine, renders the button, and fails
# at the redirect with the user already committed.
#
# Callback URLs to register with each provider:
#   {AUTH_BASE_URL}/api/auth/callback/github
#   {AUTH_BASE_URL}/api/auth/callback/google
GITHUB_CLIENT_ID=EXAMPLE-not-a-real-client-id
GITHUB_CLIENT_SECRET=EXAMPLE-not-a-real-client-secret
GOOGLE_CLIENT_ID=EXAMPLE-not-a-real-client-id
GOOGLE_CLIENT_SECRET=EXAMPLE-not-a-real-client-secret

# ── Rate limiting (M020) ────────────────────────────────────────────────────
# Shared store for rate-limit windows. WITHOUT it the limiter keeps windows in
# process memory — correct for one replica, and wrong for several: N replicas
# each counting separately enforce N times the limit. That is not an
# approximation, it is the limit not existing, and it fails silently because
# each replica looks perfectly correct on its own.
#
# Staging runs a single replica today (ADR-009). Set this before that changes.
REDIS_URL=redis://localhost:6379
