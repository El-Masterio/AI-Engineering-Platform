{
  "//": "Next.js needs bundler resolution and preserved JSX, which differ from the NodeNext base. Everything else - the \u00a721 strict set - is inherited.",
  "extends": "@atelier/config/tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // ES2024, matching the base config and the Node 24 runtime. This file
    // pinned ES2023 and so hid APIs the runtime has — the third place that
    // override was lurking after M016 bumped the base.
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "allowJs": true,
    "incremental": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    },
    "rootDir": ".",
    "outDir": ".next/tsbuild"
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", ".next", "dist"]
}
