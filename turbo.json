{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "clean": {
      "cache": false
    },
    // `^build` is not optional here. Workspace packages resolve through their
    // exports map to dist/, which a clean clone does not have — without it,
    // `pnpm dev` starts happily and then serves 500 on every route with
    // "Cannot resolve @atelier/ui". It only appeared to work locally because a
    // stale dist/ was already on disk.
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}
