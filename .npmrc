# Fail rather than silently resolve a dependency a package didn't declare.
# Catching phantom dependencies is one of the reasons ADR-001 chose pnpm.
strict-peer-dependencies=false
auto-install-peers=true

# Internal packages always resolve to the workspace copy, never the registry.
link-workspace-packages=true
prefer-workspace-packages=true
save-workspace-protocol=rolling

# Reproducible installs. CI additionally runs with --frozen-lockfile (§22).
resolution-mode=highest
