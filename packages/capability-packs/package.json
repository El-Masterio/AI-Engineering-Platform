{
  "name": "@atelier/capability-packs",
  "version": "0.0.0",
  "private": true,
  "description": "Platform SKILL.md corpus, loader, and prompt-injection scanner",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@atelier/config": "workspace:*",
    "typescript": "^5.9.3",
    "@types/node": "^26.1.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@atelier/agent-runtime": "workspace:*",
    "@atelier/contracts": "workspace:*",
    "yaml": "^2.8.1"
  }
}
