{
  "name": "@atelier/cost",
  "version": "0.0.0",
  "private": true,
  "description": "Token accounting, budget ceilings, and credit conversion (integer arithmetic only)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@atelier/config": "workspace:*",
    "typescript": "^5.9.3"
  }
}
