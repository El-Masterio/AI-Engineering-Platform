{
  "name": "atelier",
  "version": "0.0.0",
  "private": true,
  "description": "AI Engineering Platform \u2014 teams of AI agents that plan, build, review, test, and deliver software",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "build:storybook": "storybook build",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:storybook-css": "node scripts/check-storybook-css.mjs",
    "clean": "turbo run clean",
    "db:down": "docker compose down",
    "db:migrate": "turbo run build --filter=@atelier/db --filter=@atelier/config && node scripts/db-migrate.mjs",
    "db:reset": "docker compose down -v && pnpm db:up && pnpm db:migrate && pnpm db:seed",
    "db:seed": "turbo run build --filter=@atelier/db --filter=@atelier/config && node scripts/db-seed.mjs",
    "db:up": "docker compose up -d --wait",
    "depcruise": "depcruise apps packages --config .dependency-cruiser.cjs",
    "depcruise:graph": "depcruise apps packages --config .dependency-cruiser.cjs --output-type dot",
    "dev": "turbo run dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "setup": "pnpm db:up && pnpm db:migrate && pnpm db:seed",
    "storybook": "storybook dev -p 6006",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "pnpm --filter @atelier/db --filter @atelier/observability test:integration",
    "test:watch": "vitest",
    "typecheck": "turbo run typecheck",
    "verify": "pnpm format:check && pnpm lint && pnpm depcruise && pnpm knip && pnpm check:contrast && pnpm check:licenses && pnpm typecheck && pnpm test:coverage && pnpm build"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.5.4",
    "@storybook/react-vite": "^10.5.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "axe-core": "^4.12.1",
    "dependency-cruiser": "^18.1.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.1.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-unicorn": "^72.0.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "knip": "^6.29.0",
    "lint-staged": "^17.2.0",
    "postcss": "^8.5.23",
    "prettier": "^3.9.6",
    "storybook": "^10.5.4",
    "turbo": "^2.6.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
