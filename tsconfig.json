{
  "$schema": "https://json.schemastore.org/tsconfig",
  "//": "Workspace-spanning view used by TOOLING ONLY (dependency-cruiser, editors). Each package still owns its own tsconfig.json for building — that is what `pnpm build` uses. This file emits nothing.",
  "extends": "./packages/config/tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    // The workspace view now spans .tsx (packages/ui) as well as .ts.
    "jsx": "react-jsx",
    // ES2024 to match the base config and the Node 24 runtime — this file
    // overrode it back to ES2023, so the tooling view disagreed with every build.
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "outDir": ".turbo/tsconfig-noemit",
    // No `baseUrl` — deprecated in TS 7; `paths` resolves relative to this file.
    // Maps workspace packages to SOURCE rather than dist. Without this,
    // `@atelier/domain` resolves via `exports` to packages/domain/dist/index.d.ts,
    // which .dependency-cruiser.cjs excludes — so every cross-package dependency
    // vanished from the graph and the domain-purity and dev-dependency rules
    // silently never fired. Tooling-only: package builds do not extend this file.
    "paths": {
      "@atelier/*": ["./packages/*/src/index.ts"],
      // apps/web's own alias, mirrored here so dependency-cruiser can resolve it.
      "@/*": ["./apps/web/src/*"]
    }
  },
  "include": [
    "apps/*/src/**/*.ts",
    "apps/*/src/**/*.tsx",
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.tsx",
    ".storybook/**/*.ts",
    "vitest.config.ts",
    "vitest.setup.ts",
    "packages/*/vitest.*.config.ts",
    // apps too, or an app's integration config belongs to no project and ESLint
    // reports a parse error rather than a rule violation.
    "apps/*/vitest.*.config.ts"
  ],
  "exclude": ["node_modules", "**/dist/**", "**/.turbo/**", "**/.next/**"]
}
